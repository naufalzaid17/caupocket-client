---
import ProgressBar from '../ui/ProgressBar.astro';
import { formatDate, formatPercent, formatRupiah } from '../../utils/formatters';
import type { SavingGoal, Wallet } from '../../services/types';

interface Props {
  goal: SavingGoal;
  wallets?: Wallet[];
  /** compact = varian strip di dashboard, full = kartu lengkap + form setor. */
  variant?: 'compact' | 'full';
}

const { goal, wallets = [], variant = 'full' } = Astro.props;

const percent = formatPercent(goal.current_amount, goal.target_amount);
const achieved = goal.status === 'ACHIEVED';
const remaining = Math.max(0, goal.target_amount - goal.current_amount);
---

{
  variant === 'compact' ? (
    <a
      href="/goals"
      class="press block w-full rounded-2xl border border-slate-200/80 bg-white p-4 shadow-sm active:scale-95"
    >
      <div class="flex items-center justify-between gap-2">
        <p class="truncate text-sm font-semibold text-slate-900">{goal.title}</p>
        {achieved && <span class="text-sm">🎉</span>}
      </div>
      <p class="mt-2 text-xs text-slate-500">
        {formatRupiah(goal.current_amount)} / {formatRupiah(goal.target_amount)}
      </p>
      <div class="mt-2">
        <ProgressBar percent={percent} tone={achieved ? 'emerald' : 'indigo'} />
      </div>
      <p class="mt-1.5 text-right text-xs font-semibold text-slate-600">{percent}%</p>
    </a>
  ) : (
    <article class="rounded-2xl border border-slate-200/80 bg-white p-4 shadow-sm">
      <div class="flex items-start justify-between gap-3">
        <div class="min-w-0">
          <h3 class="truncate font-semibold text-slate-900">{goal.title}</h3>
          <p class="mt-0.5 text-xs text-slate-500">
            Target: {goal.target_date ? formatDate(goal.target_date) : 'tanpa tenggat'}
          </p>
        </div>
        {achieved ? (
          <span class="flex-none rounded-full bg-emerald-50 px-2.5 py-1 text-xs font-bold text-emerald-600">
            Tercapai 🎉
          </span>
        ) : (
          <span class="flex-none rounded-full bg-indigo-50 px-2.5 py-1 text-xs font-bold text-indigo-600">
            {percent}%
          </span>
        )}
      </div>

      <div class="mt-4">
        <ProgressBar percent={percent} tone={achieved ? 'emerald' : 'indigo'} />
        <div class="mt-2 flex items-baseline justify-between">
          <p class="text-sm font-bold text-slate-900">{formatRupiah(goal.current_amount)}</p>
          <p class="text-xs text-slate-500">dari {formatRupiah(goal.target_amount)}</p>
        </div>
        {!achieved && remaining > 0 && (
          <p class="mt-1 text-xs text-slate-400">Kurang {formatRupiah(remaining)} lagi</p>
        )}
      </div>

      {!achieved && wallets.length > 0 && (
        <details class="group mt-4">
          <summary class="press inline-flex h-9 items-center justify-center rounded-xl bg-indigo-600 px-4 text-sm font-semibold text-white shadow-md shadow-indigo-600/25 outline-none active:scale-95">
            Setor Tabungan
          </summary>
          <form method="POST" action="/goals" class="mt-3 flex flex-col gap-2">
            <input type="hidden" name="action" value="fund" />
            <input type="hidden" name="goal_id" value={goal.id} />
            <div class="flex gap-2">
              <input
                type="number"
                name="amount"
                min="1"
                required
                inputmode="numeric"
                placeholder="Nominal (Rp)"
                class="h-11 w-full rounded-xl border border-slate-200 px-3 text-sm outline-none focus:border-indigo-500 focus:ring-2 focus:ring-indigo-500/30"
              />
              <select
                name="wallet_id"
                class="h-11 w-36 rounded-xl border border-slate-200 bg-white px-2 text-sm outline-none focus:border-indigo-500"
                aria-label="Sumber dana"
              >
                {wallets.map((w) => (
                  <option value={w.id} selected={w.name === 'Dompet Utama'}>
                    {w.name}
                  </option>
                ))}
              </select>
            </div>
            <button
              type="submit"
              class="press h-11 rounded-xl bg-slate-900 text-sm font-semibold text-white active:scale-95"
            >
              Setor Sekarang
            </button>
          </form>
        </details>
      )}
    </article>
  )
}
