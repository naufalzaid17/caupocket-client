---
// ReceiptUploader (EPIC V2.1): unggah struk multi-device —
// kamera (mobile, capture="environment") & drag-and-drop (PC).
// Gambar dikompresi client-side (Canvas API) menjadi ≤2MB sebelum dipost.
// Hasil OCR di-broadcast via event `receipt:scanned` untuk auto-fill form.
---

<section
  data-receipt-uploader
  class="rounded-2xl border border-slate-200/80 bg-white p-4 shadow-sm"
  aria-label="Pindai struk"
>
  <div class="mb-3 flex items-center gap-2">
    <span class="icon-tile size-9 bg-indigo-50 text-indigo-600">
      <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" class="size-5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <path d="M4 2v16l2-1 2 1 2-1 2 1 2-1 2 1 2-1 2 1V2l-2 1-2-1-2 1-2-1-2 1-2-1-2 1Z"></path>
        <path d="M8 7h8M8 11h8M8 15h5"></path>
      </svg>
    </span>
    <div>
      <p class="text-sm font-semibold text-slate-900">Pindai Struk</p>
      <p class="text-xs text-slate-500">Foto struknya, form terisi otomatis (OCR)</p>
    </div>
  </div>

  <div
    data-dropzone
    class="flex flex-col items-center gap-3 rounded-xl border-2 border-dashed border-slate-300 bg-slate-50/70 px-4 py-6 text-center transition-colors"
  >
    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" class="size-8 text-slate-400" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
      <rect x="3" y="3" width="18" height="18" rx="3"></rect>
      <circle cx="9" cy="9" r="2"></circle>
      <path d="m21 15-3.5-3.5L9 20"></path>
    </svg>
    <p class="text-sm text-slate-600">Tarik &amp; lepas gambar struk ke sini</p>

    <div class="flex flex-wrap justify-center gap-2">
      <label
        for="receipt-camera"
        class="press inline-flex h-10 cursor-pointer items-center gap-1.5 rounded-xl bg-indigo-600 px-4 text-sm font-semibold text-white shadow-md shadow-indigo-600/25 active:scale-95"
      >
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" class="size-4" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M14.5 4h-5L7 7H4a2 2 0 0 0-2 2v9a2 2 0 0 0 2 2h16a2 2 0 0 0 2-2V9a2 2 0 0 0-2-2h-3l-2.5-3Z"></path>
          <circle cx="12" cy="13" r="3"></circle>
        </svg>
        Kamera
      </label>
      <label
        for="receipt-file"
        class="press inline-flex h-10 cursor-pointer items-center rounded-xl border border-slate-200 bg-white px-4 text-sm font-semibold text-slate-700 active:scale-95"
      >
        Pilih Gambar
      </label>
    </div>

    <p class="text-[11px] text-slate-400">JPG / PNG / WebP · maks 5MB · otomatis dikompres</p>

    <input
      id="receipt-camera"
      data-camera-input
      type="file"
      accept="image/jpeg,image/png,image/webp"
      capture="environment"
      class="hidden"
    />
    <input
      id="receipt-file"
      data-file-input
      type="file"
      accept="image/jpeg,image/png,image/webp"
      class="hidden"
    />
  </div>

  <p
    data-status
    class="mt-2 hidden rounded-xl px-3 py-2 text-xs font-medium"
    role="status"
    aria-live="polite"
  ></p>
</section>

<script>
  const MAX_UPLOAD_BYTES = 2 * 1024 * 1024; // batas kompresi client-side
  const MAX_DIMENSION = 1600;

  function initReceiptUploaders(): void {
    document.querySelectorAll<HTMLElement>('[data-receipt-uploader]:not([data-ready])').forEach((root) => {
      root.setAttribute('data-ready', 'true');
      const zone = root.querySelector<HTMLElement>('[data-dropzone]');
      const status = root.querySelector<HTMLElement>('[data-status]');
      const inputs = root.querySelectorAll<HTMLInputElement>('input[type="file"]');
      if (!zone || !status) return;

      const setStatus = (text: string | null, tone: 'busy' | 'ok' | 'error' = 'busy'): void => {
        if (!text) {
          status.classList.add('hidden');
          return;
        }
        status.textContent = text;
        status.classList.remove('hidden');
        status.classList.toggle('bg-slate-100', tone === 'busy');
        status.classList.toggle('text-slate-600', tone === 'busy');
        status.classList.toggle('bg-emerald-50', tone === 'ok');
        status.classList.toggle('text-emerald-700', tone === 'ok');
        status.classList.toggle('bg-rose-50', tone === 'error');
        status.classList.toggle('text-rose-700', tone === 'error');
      };

      /** Kompresi via Canvas: batasi dimensi, iterasi kualitas JPEG hingga ≤2MB. */
      async function compressImage(file: File): Promise<File> {
        if (file.size <= MAX_UPLOAD_BYTES) return file;
        const bitmap = await createImageBitmap(file);
        const scale = Math.min(1, MAX_DIMENSION / Math.max(bitmap.width, bitmap.height));
        const canvas = document.createElement('canvas');
        canvas.width = Math.max(1, Math.round(bitmap.width * scale));
        canvas.height = Math.max(1, Math.round(bitmap.height * scale));
        const ctx = canvas.getContext('2d');
        if (!ctx) return file;
        ctx.drawImage(bitmap, 0, 0, canvas.width, canvas.height);
        bitmap.close();

        let quality = 0.85;
        let blob = await new Promise<Blob | null>((resolve) =>
          canvas.toBlob(resolve, 'image/jpeg', quality),
        );
        while (blob && blob.size > MAX_UPLOAD_BYTES && quality > 0.5) {
          quality -= 0.1;
          blob = await new Promise<Blob | null>((resolve) =>
            canvas.toBlob(resolve, 'image/jpeg', quality),
          );
        }
        if (!blob) return file;
        return new File([blob], 'receipt.jpg', { type: 'image/jpeg' });
      }

      async function handleFile(file: File | undefined | null): Promise<void> {
        if (!file) return;
        if (!/^image\/(jpeg|png|webp)$/.test(file.type)) {
          setStatus('Format harus JPG, PNG, atau WebP.', 'error');
          return;
        }
        try {
          setStatus('Mengompresi gambar…');
          const compressed = await compressImage(file);
          setStatus('Memindai struk…');
          const fd = new FormData();
          fd.append('file', compressed, file.name || 'receipt.jpg');

          const res = await fetch('/api/ocr-receipt', { method: 'POST', body: fd });
          const json = (await res.json().catch(() => null)) as
            | { success: boolean; message: string; data?: unknown }
            | null;
          if (!res.ok || !json?.success) {
            setStatus(json?.message ?? 'Gagal memindai struk.', 'error');
            return;
          }

          const data = json.data as {
            merchant_name?: string | null;
            total_amount?: number | null;
          };
          setStatus(
            `Struk terbaca${data.merchant_name ? `: ${data.merchant_name}` : ''}${
              data.total_amount ? ` · Rp${data.total_amount.toLocaleString('id-ID')}` : ''
            }`,
            'ok',
          );
          document.dispatchEvent(new CustomEvent('receipt:scanned', { detail: data }));
        } catch {
          setStatus('Terjadi kesalahan jaringan saat mengunggah.', 'error');
        }
      }

      inputs.forEach((input) =>
        input.addEventListener('change', () => {
          void handleFile(input.files?.[0]);
          input.value = '';
        }),
      );

      zone.addEventListener('dragover', (e) => {
        e.preventDefault();
        zone.classList.add('border-indigo-400', 'bg-indigo-50/60');
      });
      zone.addEventListener('dragleave', () => {
        zone.classList.remove('border-indigo-400', 'bg-indigo-50/60');
      });
      zone.addEventListener('drop', (e) => {
        e.preventDefault();
        zone.classList.remove('border-indigo-400', 'bg-indigo-50/60');
        void handleFile(e.dataTransfer?.files?.[0]);
      });
    });
  }

  document.addEventListener('astro:page-load', initReceiptUploaders);
  initReceiptUploaders();
</script>
