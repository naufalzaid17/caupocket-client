---
interface Props {
  icon?: string;
  title: string;
  description?: string;
}

const { icon = '🪄', title, description } = Astro.props;
---

<div class="flex flex-col items-center gap-2 rounded-2xl border border-dashed border-slate-300 bg-white/50 px-6 py-10 text-center">
  <span class="text-3xl" aria-hidden="true">{icon}</span>
  <p class="font-semibold text-slate-700">{title}</p>
  {description && <p class="text-sm text-slate-500">{description}</p>}
  <slot />
</div>
