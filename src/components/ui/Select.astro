---
interface Props {
  label: string;
  name: string;
  options: { value: string; label: string }[];
  selected?: string;
  required?: boolean;
}

const { label, name, options, selected, required = false } = Astro.props;
const id = `field-${name}`;
---

<div class="flex flex-col gap-1.5">
  <label for={id} class="text-sm font-medium text-slate-700">{label}</label>
  <select
    id={id}
    name={name}
    required={required}
    class="h-12 w-full appearance-none rounded-xl border border-slate-200 bg-white px-4 text-base text-slate-900 outline-none transition focus:border-indigo-500 focus:ring-2 focus:ring-indigo-500/30"
  >
    {options.map((opt) => <option value={opt.value} selected={opt.value === selected}>{opt.label}</option>)}
  </select>
</div>
